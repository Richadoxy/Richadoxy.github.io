        </mxCell>
        <mxCell id="noise_time" value="&lt;b&gt;Gaussian noise ε + flow time τ&lt;/b&gt;&lt;br&gt;construct noisy action A&lt;sup&gt;τ&lt;/sup&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;training / iterative inference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF991F;strokeWidth=1.5;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
