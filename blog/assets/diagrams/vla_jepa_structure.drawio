        </mxCell>

        <mxCell id="qwen" value="&lt;b&gt;Qwen3-VL student / online backbone&lt;/b&gt;&lt;br&gt;SigLIP-2 vision encoder + Qwen3 language model&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;processes current images + instruction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=2;fontColor=#0747A6;fontSize=15;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="425" y="175" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="context_tokens" value="&lt;b&gt;Vision-language context tokens&lt;/b&gt;&lt;br&gt;current scene semantics + task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2FF;strokeColor=#4C9AFF;strokeWidth=1.5;fontColor=#0747A6;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="805" y="180" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="latent_tokens" value="&lt;b&gt;Learnable latent/action tokens&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;t&lt;/sub&gt;: action-relevant transition representation&lt;br&gt;z&lt;sub&gt;a&lt;/sub&gt;: condition for physical action generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D4FF;strokeColor=#0052CC;strokeWidth=2;fontColor=#0747A6;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="630" y="330" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="state_encoder" value="&lt;b&gt;State Encoder&lt;/b&gt;&lt;br&gt;q&lt;sub&gt;t&lt;/sub&gt; → state tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00B8D9;strokeWidth=1.5;fontColor=#006677;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="425" y="510" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="noisy_action_encoder" value="&lt;b&gt;Action Encoder + time embedding&lt;/b&gt;&lt;br&gt;(A&lt;sup&gt;τ&lt;/sup&gt;, τ) → noisy action tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="425" y="690" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="dit" value="&lt;b&gt;DiT-B Flow-Matching Action Head&lt;/b&gt;&lt;br&gt;self-attention over state/action tokens&lt;br&gt;cross-attention to Qwen context / z&lt;sub&gt;a&lt;/sub&gt;&lt;br&gt;timestep-conditioned normalization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=15;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="750" y="620" width="370" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="velocity" value="&lt;b&gt;Predicted flow velocity&lt;/b&gt;&lt;br&gt;v&lt;sub&gt;θ&lt;/sub&gt;(A&lt;sup&gt;τ&lt;/sup&gt;, τ | z&lt;sub&gt;a&lt;/sub&gt;, q&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;shape [B, H, D&lt;sub&gt;a&lt;/sub&gt;]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="805" y="820" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fm_loss" value="&lt;b&gt;Action supervision L&lt;sub&gt;FM&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;MSE(predicted velocity, target velocity)&lt;br&gt;&lt;font color=&quot;#BF2600&quot;&gt;requires labeled robot actions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=2;fontColor=#BF2600;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="780" y="975" width="330" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="teacher_encoder" value="&lt;b&gt;Frozen V-JEPA2 Target Encoder&lt;/b&gt;&lt;br&gt;encodes each training-video timestep&lt;br&gt;&lt;font color=&quot;#403294&quot;&gt;stop-gradient · no optimizer update&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;dashed=1;fontColor=#403294;fontSize=15;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1515" y="190" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="target_latents" value="&lt;b&gt;Teacher world-state latent sequence&lt;/b&gt;&lt;br&gt;s&lt;sub&gt;t0:tT&lt;/sub&gt; = F(I&lt;sub&gt;t0:tT&lt;/sub&gt;)&lt;br&gt;&lt;font color=&quot;#403294&quot;&gt;history = causal input · future = target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;dashed=1;fontColor=#403294;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1515" y="350" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="world_predictor" value="&lt;b&gt;Online Action-Conditioned World Predictor&lt;/b&gt;&lt;br&gt;history/current latent + z&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;→ predict future latent states&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;trainable Student component&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=2;fontColor=#0747A6;fontSize=15;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1440" y="555" width="380" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="pred_latents" value="&lt;b&gt;Predicted future-state latents&lt;/b&gt;&lt;br&gt;ŝ&lt;sub&gt;t+1:t+T&lt;/sub&gt;&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;semantic world transition prediction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#0747A6;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1440" y="735" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="jepa_loss" value="&lt;b&gt;World-model supervision L&lt;sub&gt;WM&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;distance(ŝ&lt;sub&gt;future&lt;/sub&gt;, stopgrad(s&lt;sub&gt;future&lt;/sub&gt;))&lt;br&gt;&lt;font color=&quot;#403294&quot;&gt;latent prediction · no pixel reconstruction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=14;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1510" y="900" width="360" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="no_leak" value="&lt;b&gt;Leakage-free rule&lt;/b&gt;&lt;br&gt;future frames cannot enter Qwen&lt;br&gt;time-causal mask blocks future latent input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F6;strokeColor=#FF5630;strokeWidth=1.5;dashed=1;fontColor=#BF2600;fontSize=13;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1780" y="520" width="240" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="total_loss" value="&lt;b&gt;Joint training objective&lt;/b&gt;&lt;br&gt;L = L&lt;sub&gt;FM&lt;/sub&gt; + β · L&lt;sub&gt;WM&lt;/sub&gt;&lt;br&gt;&lt;font color=&quot;#BF2600&quot;&gt;gradient updates Student/VLM, predictor and action head; never Target Encoder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=2;fontColor=#BF2600;fontSize=15;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="500" y="1195" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="euler" value="&lt;b&gt;Inference: Euler integration / iterative denoising&lt;/b&gt;&lt;br&gt;noise → repeated DiT velocity updates → action chunk&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;standard setting: current observation + Qwen3-VL + DiT only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=15;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1120" y="1195" width="540" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="action_output" value="&lt;b&gt;Robot action chunk&lt;/b&gt;&lt;br&gt;â&lt;sub&gt;0:H&lt;/sub&gt; [B, H, D&lt;sub&gt;a&lt;/sub&gt;]&lt;br&gt;unnormalize → execute / receding horizon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABF5D1;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=15;spacing=8;" parent="1" vertex="1">
