        <mxCell id="gt_actions" value="&lt;b&gt;Ground-truth robot actions&lt;/b&gt;&lt;br&gt;A&lt;sub&gt;0:H&lt;/sub&gt;&lt;br&gt;&lt;font color=&quot;#BF2600&quot;&gt;robot-data training only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=1.5;fontColor=#BF2600;fontSize=14;spacing=8;" parent="1" vertex="1">
