                <mxCell id="title" value="&lt;b&gt;FAST + Knowledge Insulation · 双动作监督与梯度边界&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontColor=#172B4D;" parent="1" vertex="1">
                    <mxGeometry x="120" y="20" width="1680" height="50" as="geometry" />
                </mxCell>
                <mxCell id="subtitle" value="KI 联合训练示意；公开 openpi π₀.₅ 微调只保留 flow 路径" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#5E6C84;" parent="1" vertex="1">
                    <mxGeometry x="250" y="75" width="1420" height="34" as="geometry" />
                </mxCell>
                <mxCell id="dataflow_legend" value="同一条示范构造两种动作目标 · 实线箭头表示前向数据流" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#5E6C84;" parent="1" vertex="1">
                    <mxGeometry x="70" y="140" width="800" height="30" as="geometry" />
                </mxCell>
                <mxCell id="discrete_lane_title" value="&lt;b&gt;1 · 离散动作监督 / VLM representation learning&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#0747A6;" parent="1" vertex="1">
                    <mxGeometry x="430" y="385" width="800" height="32" as="geometry" />
                </mxCell>
                <mxCell id="flow_lane_title" value="&lt;b&gt;2 · 连续动作监督 / Flow matching&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#7A3E00;" parent="1" vertex="1">
                    <mxGeometry x="430" y="895" width="760" height="28" as="geometry" />
                </mxCell>
                <mxCell id="ground_truth" value="&lt;b&gt;真实未来动作 A&lt;/b&gt;&lt;br&gt;Expert action chunk&lt;br&gt;[H, D]" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFFFFF;strokeColor=#7A869A;fontColor=#172B4D;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="200" width="280" height="105" as="geometry" />
                </mxCell>
                <mxCell id="fast" value="&lt;b&gt;FAST tokenizer&lt;/b&gt;&lt;br&gt;DCT → 量化 → BPE&lt;br&gt;构造标签，不由 CE 反向训练" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="470" y="200" width="300" height="105" as="geometry" />
                </mxCell>
                <mxCell id="tokens" value="&lt;b&gt;离散动作标签 z₁:K&lt;/b&gt;&lt;br&gt;token IDs&lt;br&gt;z = FAST(A)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="990" y="200" width="260" height="105" as="geometry" />
                </mxCell>
                <mxCell id="observations" value="&lt;b&gt;可观测条件 c&lt;/b&gt;&lt;br&gt;图像 + 语言 + 当前 state&lt;br&gt;不包含真实未来动作" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFFFFF;strokeColor=#7A869A;fontColor=#172B4D;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="450" width="280" height="120" as="geometry" />
                </mxCell>
                <mxCell id="vlm" value="&lt;b&gt;VLM backbone · θ&lt;/b&gt;&lt;br&gt;图像编码器 + 语言主干&lt;br&gt;条件位置 + 离散动作位置" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#B3D4FF;strokeColor=#0052CC;fontColor=#0747A6;strokeWidth=2;fontSize=19;" parent="1" vertex="1">
                    <mxGeometry x="470" y="440" width="360" height="145" as="geometry" />
                </mxCell>
                <mxCell id="logits" value="&lt;b&gt;预测动作 logits&lt;/b&gt;&lt;br&gt;pθ(zᵢ | c, z&amp;lt;ᵢ)&lt;br&gt;词表上的条件分布" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="455" width="250" height="110" as="geometry" />
                </mxCell>
                <mxCell id="ce" value="&lt;b&gt;Next-token CE&lt;/b&gt;&lt;br&gt;LFAST = −Σᵢ log pθ(zᵢ | c, z&amp;lt;ᵢ)&lt;br&gt;预测分布 vs. 真实 token ID" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;strokeWidth=2;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="445" width="300" height="130" as="geometry" />
                </mxCell>
                <mxCell id="teacher_forcing" value="&lt;b&gt;Teacher forcing&lt;/b&gt;：正确历史 z&amp;lt;ᵢ 仅输入 VLM 的动作 token 位置；因果 mask 防止看见未来标签，观测 prefix 不读取动作标签。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#0747A6;" parent="1" vertex="1">
                    <mxGeometry x="850" y="310" width="620" height="60" as="geometry" />
                </mxCell>
                <mxCell id="ce_gradient" value="&lt;b&gt;反向：CE 更新 VLM 参数 θ&lt;/b&gt;&lt;br&gt;还可混入文字 / 视觉语言目标；主干没有被冻结。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#0747A6;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="620" width="430" height="80" as="geometry" />
                </mxCell>
                <mxCell id="condition_kv" value="&lt;b&gt;各层条件位置的 K / V&lt;/b&gt;&lt;br&gt;来自图像、语言、state&lt;br&gt;不含 FAST 动作位置" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#403294;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="510" y="635" width="280" height="100" as="geometry" />
                </mxCell>
                <mxCell id="stop_gradient" value="&lt;b&gt;stop_gradient(K / V)&lt;/b&gt;&lt;br&gt;前向数值保留，可继续读取&lt;br&gt;反向：∂Lflow / ∂θ = 0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#403294;strokeWidth=2;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="510" y="770" width="280" height="110" as="geometry" />
                </mxCell>
                <mxCell id="attention_mask" value="&lt;b&gt;Attention mask：先规定能读什么&lt;/b&gt;&lt;br&gt;FAST 动作位置 ↔ 连续动作位置：互不可读&lt;br&gt;两条分支都能读取观测条件位置&lt;br&gt;&lt;br&gt;stop-gradient 再规定梯度能回到哪里" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFEBE6;strokeColor=#FF5630;fontColor=#BF2600;strokeWidth=2;fontSize=17;" parent="1" vertex="1">
                    <mxGeometry x="930" y="660" width="470" height="145" as="geometry" />
                </mxCell>
                <mxCell id="noise_time" value="&lt;b&gt;采样 ε 与 t&lt;/b&gt;&lt;br&gt;ε ~ N(0, I), t ∈ [0, 1]&lt;br&gt;t = 1 为噪声，t = 0 为动作" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFE8CC;strokeColor=#FF991F;fontColor=#7A3E00;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="720" width="280" height="115" as="geometry" />
                </mxCell>
                <mxCell id="flow_construct" value="&lt;b&gt;由 A、ε、t 构造监督&lt;/b&gt;&lt;br&gt;带噪动作：xₜ = (1−t)A + tε&lt;br&gt;目标速度：uₜ = ε − A" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFE8CC;strokeColor=#FF991F;fontColor=#7A3E00;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="920" width="280" height="140" as="geometry" />
                </mxCell>
                <mxCell id="noisy_action" value="&lt;b&gt;Noisy action xₜ + timestep t&lt;/b&gt;&lt;br&gt;动作投影 + 时间嵌入&lt;br&gt;连续 action hidden positions" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFE8CC;strokeColor=#FF991F;fontColor=#7A3E00;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="470" y="935" width="300" height="110" as="geometry" />
                </mxCell>
                <mxCell id="expert" value="&lt;b&gt;Action Expert · φ&lt;/b&gt;&lt;br&gt;读取带噪动作、t&lt;br&gt;以及 sg(K / V) 条件" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFD59A;strokeColor=#FF8B00;fontColor=#7A3E00;strokeWidth=2;fontSize=19;" parent="1" vertex="1">
                    <mxGeometry x="900" y="930" width="300" height="120" as="geometry" />
                </mxCell>
                <mxCell id="velocity" value="&lt;b&gt;预测 velocity vφ&lt;/b&gt;&lt;br&gt;形状 [H, D]&lt;br&gt;生成路径上的速度" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="935" width="210" height="110" as="geometry" />
                </mxCell>
                <mxCell id="flow_loss" value="&lt;b&gt;Flow matching loss&lt;/b&gt;&lt;br&gt;Lflow = MSE(vφ, uₜ)&lt;br&gt;预测速度 vs. 目标速度" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1570" y="925" width="270" height="130" as="geometry" />
                </mxCell>
                <mxCell id="velocity_target" value="&lt;b&gt;真实目标 uₜ = ε − A&lt;/b&gt;&lt;br&gt;由本次示范与采样噪声算出" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFE8CC;strokeColor=#FF991F;fontColor=#7A3E00;strokeWidth=2;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="1120" width="280" height="80" as="geometry" />
                </mxCell>
                <mxCell id="expert_gradient" value="&lt;b&gt;反向：Lflow 更新 expert φ&lt;/b&gt;&lt;br&gt;经 K/V 回到 VLM 的梯度被阻断" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#7A3E00;" parent="1" vertex="1">
                    <mxGeometry x="850" y="1065" width="390" height="60" as="geometry" />
                </mxCell>
                <mxCell id="inference_note" value="动作推理：从噪声开始，沿 t: 1 → 0 积分；使用连续 expert，无需先生成 FAST 动作 token。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#5E6C84;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1228" width="1430" height="34" as="geometry" />
                </mxCell>
                <mxCell id="original_pi05" value="&lt;b&gt;原始 π₀.₅ 论文 · 两阶段&lt;/b&gt;&lt;br&gt;&lt;br&gt;预训练：FAST 等 token 预测&lt;br&gt;后训练：加入 action expert，联合 token + flow&lt;br&gt;阶段安排 ≠ 同时存在几条 loss 分支" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;strokeWidth=2;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1310" width="570" height="150" as="geometry" />
                </mxCell>
                <mxCell id="ki_recipe" value="&lt;b&gt;后续 KI · 联合训练&lt;/b&gt;&lt;br&gt;&lt;br&gt;FAST / 文字目标更新 VLM&lt;br&gt;flow 目标更新 expert，K/V 接口隔离梯度&lt;br&gt;本图描述这一训练配方" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#403294;strokeWidth=2;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="675" y="1310" width="570" height="150" as="geometry" />
                </mxCell>
                <mxCell id="public_finetune" value="&lt;b&gt;公开 openpi π₀.₅ 微调 · flow-only&lt;/b&gt;&lt;br&gt;&lt;br&gt;继承 KI 训练过的 checkpoint&lt;br&gt;无 FAST CE，也无这条 KI stop-gradient&lt;br&gt;flow 更新谁，取决于全参 / LoRA / 冻结配置" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fillColor=#FFE8CC;strokeColor=#FF991F;fontColor=#7A3E00;strokeWidth=2;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="1310" width="570" height="150" as="geometry" />
                </mxCell>
                <mxCell id="footer" value="参照 FAST (arXiv:2501.09747)、KI (arXiv:2505.23705) 与 openpi 215abfb · 代码核对：2026-10-17" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#5E6C84;" parent="1" vertex="1">
